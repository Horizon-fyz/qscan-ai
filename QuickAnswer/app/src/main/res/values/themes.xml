<?xml version="1.0" encoding="utf-8"?>
<!-- 主题与文字层级：MT 管理器式中性工具型视觉（日间基准）。
     字体：系统 sans-serif（正文）/ sans-serif-medium（500–600 字重）。
     日夜模式：父类 DayNight，夜间差异见 values-night/themes.xml。 -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QuickAnswer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/brand_navy</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/canvas</item>
        <!-- 顶部为中性灰 app bar，状态栏同色 + 深色图标 -->
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- 导出选择器：完全透明的浮层宿主，仅承载对话框与后台 WebView 渲染 -->
    <style name="Theme.QuickAnswer.Transparent" parent="Theme.QuickAnswer">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ===== 文字层级 ===== -->

    <!-- micro-uppercase：app bar 上的眉标 -->
    <style name="Tv.HeroEyebrow" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/brand_purple_300</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- heading-4：app bar 主标题 -->
    <style name="Tv.HeroTitle" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- body-sm：app bar 副标题 -->
    <style name="Tv.HeroSubtitle" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_dark_muted</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <!-- heading-5：卡片标题 -->
    <style name="Tv.SectionTitle" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- body-md：主正文 -->
    <style name="Tv.Body" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.55</item>
    </style>

    <!-- body-sm：次级正文 -->
    <style name="Tv.BodySm" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/slate</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <!-- caption：说明/状态 -->
    <style name="Tv.Caption" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/steel</item>
    </style>

    <!-- micro-uppercase：表单字段标签 -->
    <style name="Tv.Label" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/steel</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- caption-bold：区域标签 chip 文字 -->
    <style name="Tv.Tag" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/charcoal</item>
    </style>

    <!-- ===== 按钮 ===== -->

    <style name="Btn.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
    </style>

    <style name="Btn.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
    </style>

    <style name="Btn.Ghost" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_tertiary</item>
        <item name="android:textColor">@color/slate</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/control_height</item>
    </style>

    <!-- 答案区右上角小操作 chip：ghost 底、12sp、紧凑（复制 / 分享） -->
    <style name="Chip.Action" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_button_tertiary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/slate</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 底栏上的 chip：条状背景文字色，底仍用 ghost 透明 -->
    <style name="Chip.Dark" parent="Chip.Action">
        <item name="android:textColor">@color/on_dark</item>
    </style>
</resources>
