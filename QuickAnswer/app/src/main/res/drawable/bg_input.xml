<?xml version="1.0" encoding="utf-8"?>
<!-- text-input：canvas 白底 + hairline-strong 1px 描边，圆角 md(8dp)；聚焦态切换为 2px primary 紫描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas" />
            <stroke android:width="1dp" android:color="@color/hairline_strong" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
