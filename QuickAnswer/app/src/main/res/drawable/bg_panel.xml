<?xml version="1.0" encoding="utf-8"?>
<!-- 结果面板：canvas 白卡 + hairline 描边，圆角 lg(12dp)。
     扩展值：面板作为系统级悬浮窗覆盖于任意应用之上，布局中补一层轻 elevation 保证可辨识度，不加深投影。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/canvas" />
    <stroke android:width="1dp" android:color="@color/hairline" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
