<?xml version="1.0" encoding="utf-8"?>
<!-- 保存 API Key 对话框：确认 Key、选择所属厂商；厂商无官方答题接口或选择「自定义」时，
     可填写请求地址与模型名（OpenAI 兼容）。设计基准：raycast + linear.app（hairline、无阴影）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        style="@style/Tv.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/key_field_api" />

    <EditText
        android:id="@+id/etKey"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_input"
        android:fontFamily="sans-serif"
        android:hint="@string/api_key_hint"
        android:inputType="text"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="15sp" />

    <TextView
        style="@style/Tv.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/key_field_vendor" />

    <LinearLayout
        android:id="@+id/rowVendor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_input"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md">

        <TextView
            android:id="@+id/tvVendorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="›"
            android:textColor="@color/steel"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVendorNote"
        style="@style/Tv.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs" />

    <!-- 自定义通道：请求地址 + 模型名（选择官方厂商时隐藏） -->
    <LinearLayout
        android:id="@+id/groupCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Tv.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/key_field_base" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_input"
            android:fontFamily="sans-serif"
            android:hint="@string/custom_base_hint"
            android:inputType="textUri"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            style="@style/Tv.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/key_field_model" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_input"
            android:fontFamily="sans-serif"
            android:hint="@string/custom_model_hint"
            android:inputType="text"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNote"
        style="@style/Tv.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/key_dialog_note" />
</LinearLayout>
