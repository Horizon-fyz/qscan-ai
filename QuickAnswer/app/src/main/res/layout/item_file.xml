<?xml version="1.0" encoding="utf-8"?>
<!-- 文件列表行（MT 式紧凑高密度）：类型彩色图标 + 名称 + 元信息 + 右侧勾选。
     选中行由 bg_list_item 呈现淡蓝高亮，右侧 ✓ 勾选指示。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_list_item"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_xs"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/space_xs"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_fm_file" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/Tv.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMeta"
            style="@style/Tv.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/space_xxs"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/primary"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
