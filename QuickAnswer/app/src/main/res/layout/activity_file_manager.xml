<?xml version="1.0" encoding="utf-8"?>
<!-- 文件管理页（基准 notion/DESIGN.md）：深蓝顶栏 + 路径行 + 工具行 + 列表。
     与首页/使用说明页共享同一顶栏语言，工具用 Chip.Action 承载，保持轻量。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xs">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/on_dark"
            android:textSize="26sp" />

        <TextView
            style="@style/Tv.HeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:text="@string/fm_title" />
    </LinearLayout>

    <!-- 路径行：上级 + 当前路径 + 刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xs">

        <TextView
            android:id="@+id/btnUp"
            style="@style/Chip.Action"
            android:contentDescription="@string/fm_up"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/fm_up" />

        <TextView
            android:id="@+id/tvPath"
            style="@style/Tv.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="@string/fm_root" />

        <TextView
            android:id="@+id/btnRefresh"
            style="@style/Chip.Action"
            android:contentDescription="@string/fm_refresh"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/fm_refresh" />
    </LinearLayout>

    <!-- 工具行：新建 / 排序 / 粘贴 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            android:id="@+id/btnNewFolder"
            style="@style/Chip.Action"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/fm_new_folder" />

        <TextView
            android:id="@+id/btnSort"
            style="@style/Chip.Action"
            android:layout_marginStart="@dimen/space_xs"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/fm_sort" />

        <TextView
            android:id="@+id/btnPaste"
            style="@style/Chip.Action"
            android:layout_marginStart="@dimen/space_xs"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/fm_paste"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 列表区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/canvas">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/hairline_soft"
            android:dividerHeight="1dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            style="@style/Tv.BodySm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/fm_empty" />
    </FrameLayout>
</LinearLayout>
