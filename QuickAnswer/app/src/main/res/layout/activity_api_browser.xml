<?xml version="1.0" encoding="utf-8"?>
<!-- 开放平台页：内置浏览器外壳，仅允许访问各厂商开放平台 / 控制台。
     顶栏（返回 / 标题 / 厂商）沿用 app bar 语言；内容区在「厂商列表」与「WebView」之间切换。
     设计基准：awesome-design-md raycast + linear.app（中性灰面、单一蓝强调、hairline 描边、无阴影）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 标题 +（浏览态）厂商列表入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xs">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/on_dark"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Tv.HeroTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/browser_title" />

        <TextView
            android:id="@+id/tvPortal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_button_tertiary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/browser_portal"
            android:textColor="@color/brand_purple_300"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface">

        <!-- 厂商列表（默认视图） -->
        <ScrollView
            android:id="@+id/scrollList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    style="@style/Tv.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/browser_note" />

                <LinearLayout
                    android:id="@+id/listContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- 内置浏览器（浏览态） -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/canvas"
            android:visibility="gone" />

        <!-- 顶部加载进度条 -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/primary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
