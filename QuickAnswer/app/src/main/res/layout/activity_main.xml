<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面（基准 notion/DESIGN.md）：
     深蓝 hero band(brand-navy) 头图 + 浅灰 surface 页底 + 白色 card-base 卡片 +
     单一紫色主导 CTA(button-primary) + pill-tab 模型切换 + 深蓝底浅紫眉标 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Hero band：Notion 深蓝头图 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Tv.HeroEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eyebrow" />

        <TextView
            style="@style/Tv.HeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/app_name" />

        <TextView
            style="@style/Tv.HeroSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:text="@string/subtitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- 使用说明卡（card-base） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <TextView
                    style="@style/Tv.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/usage_title" />

                <TextView
                    style="@style/Tv.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/usage_body" />
            </LinearLayout>

            <!-- 配置卡（card-base） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <TextView
                    style="@style/Tv.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_title" />

                <TextView
                    style="@style/Tv.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/api_key_title" />

                <EditText
                    android:id="@+id/etKey"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_height"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_input"
                    android:fontFamily="sans-serif"
                    android:hint="@string/api_key_hint"
                    android:inputType="textVisiblePassword"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Tv.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/api_key_note" />

                <TextView
                    style="@style/Tv.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/model_title" />

                <!-- 模型切换：pill-tab（选中 = ink-deep 实底白字，未选中 = 透明 + hairline 描边） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/segChat"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_height"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:background="@drawable/bg_segment_selected"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/model_chat"
                        android:textColor="@color/on_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/segReasoner"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_height"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:background="@drawable/bg_segment_default"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/model_reasoner"
                        android:textColor="@color/steel"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOverlay"
                    style="@style/Btn.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/step_overlay" />

                <Button
                    android:id="@+id/btnNotify"
                    style="@style/Btn.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/step_notify" />

                <!-- 单一主导 CTA：Notion 签名紫 -->
                <Button
                    android:id="@+id/btnStart"
                    style="@style/Btn.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/step_start" />

                <Button
                    android:id="@+id/btnStop"
                    style="@style/Btn.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/stop_service" />

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/Tv.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/status_idle" />
            </LinearLayout>

            <TextView
                style="@style/Tv.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/footer" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
