<?xml version="1.0" encoding="utf-8"?>
<!-- 使用说明页：只承载操作步骤与模式说明，与首页、密钥设置页职责分离。
     基准 notion/DESIGN.md。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xs">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/on_dark"
            android:textSize="26sp" />

        <TextView
            style="@style/Tv.HeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:text="@string/usage_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <TextView
                    style="@style/Tv.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/usage_body" />
            </LinearLayout>

            <TextView
                style="@style/Tv.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/footer" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
