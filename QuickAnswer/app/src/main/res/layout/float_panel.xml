<?xml version="1.0" encoding="utf-8"?>
<!-- 结果面板（基准 notion/DESIGN.md）：canvas 白卡（圆角 lg）。
     上半区「题目识别」= surface 浅灰底，下半区「答案输出」= 白底 + hairline 描边，两区按 weight 等分。
     顶部 grabber 拖动条 + 标题区为拖拽手柄（id=panelHeader）。
     区域标签采用 badge-tag chip：题目=peach / 答案=lavender，呼应 Notion 彩色属性标签。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="320dp"
    android:layout_height="@dimen/panel_height"
    android:background="@drawable/bg_panel"
    android:elevation="6dp"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <!-- 拖动头：拖动条 + 标题 + 关闭 -->
    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:layout_width="@dimen/grabber_width"
            android:layout_height="@dimen/grabber_height"
            android:background="@drawable/bg_grabber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Tv.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/panel_title" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/steel"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        style="@style/Tv.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/panel_status_idle" />

    <!-- 上半区：题目识别 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1"
        android:background="@drawable/bg_zone_question"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <TextView
            style="@style/Tv.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_peach"
            android:paddingStart="@dimen/space_xs"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="2dp"
            android:text="@string/panel_question_label"
            android:textColor="@color/brand_orange_deep" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvQuestion"
                style="@style/Tv.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/panel_question_empty" />
        </ScrollView>
    </LinearLayout>

    <!-- 下半区：答案输出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_weight="1"
        android:background="@drawable/bg_zone_answer"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <TextView
            style="@style/Tv.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_lavender"
            android:paddingStart="@dimen/space_xs"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="2dp"
            android:text="@string/panel_answer_label"
            android:textColor="@color/brand_purple_800" />

        <ScrollView
            android:id="@+id/svAnswer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvAnswer"
                style="@style/Tv.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/panel_answer_empty" />
        </ScrollView>
    </LinearLayout>

    <!-- 操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopy"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_copy" />

        <Button
            android:id="@+id/btnReread"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/btn_reread" />
    </LinearLayout>
</LinearLayout>
