<?xml version="1.0" encoding="utf-8"?>
<!-- 设计令牌夜间覆盖：与 values/colors.xml 同名互为覆盖，全 App 自动切换为暗色。 -->
<resources>
    <!-- Accent & Primary -->
    <color name="primary">#4A9EFF</color>            <!-- 夜间提亮蓝，保证暗底对比度 -->
    <color name="primary_pressed">#3D8BE0</color>
    <color name="primary_deep">#2E7BD6</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="brand_navy">#212121</color>         <!-- app bar / 条状背景 -->
    <color name="brand_navy_deep">#1A1A1A</color>
    <color name="brand_navy_mid">#3A3A3A</color>
    <color name="link_blue">#4A9EFF</color>
    <color name="brand_orange">#FB8C00</color>
    <color name="brand_orange_deep">#FFB871</color>
    <color name="brand_purple_300">#7FB2FF</color>    <!-- 条状背景上的强调（亮蓝） -->
    <color name="brand_purple_800">#B9A6E8</color>
    <color name="brand_green">#1AAE39</color>

    <!-- Card Tints（暗色下的低饱和分类底色） -->
    <color name="tint_peach">#3A2A1A</color>
    <color name="tint_rose">#3A1F2B</color>
    <color name="tint_mint">#16301F</color>
    <color name="tint_lavender">#2A2A3A</color>
    <color name="tint_sky">#16283A</color>
    <color name="tint_yellow">#332E14</color>
    <color name="tint_yellow_bold">#4A441F</color>
    <color name="tint_cream">#2C2A1F</color>
    <color name="tint_gray">#262626</color>

    <!-- 列表选中行底色（MT 式淡蓝高亮） -->
    <color name="row_selected">#1B2B3D</color>

    <!-- Surface ladder -->
    <color name="canvas">#1E1E1E</color>             <!-- 页面/卡片底 -->
    <color name="surface">#121212</color>            <!-- 次级区块底 -->
    <color name="surface_soft">#262626</color>
    <color name="hairline">#333333</color>           <!-- 1px 描边/分隔 -->
    <color name="hairline_soft">#2A2A2A</color>
    <color name="hairline_strong">#454545</color>

    <!-- Text -->
    <color name="ink_deep">#FFFFFF</color>
    <color name="ink">#E6E6E6</color>
    <color name="charcoal">#E6E6E6</color>
    <color name="slate">#B0B0B0</color>
    <color name="steel">#9A9A9A</color>
    <color name="stone">#7A7A7A</color>
    <color name="muted">#6E6E6E</color>
    <color name="on_dark">#ECECEC</color>            <!-- 条状背景上的文字（夜间为浅色） -->
    <color name="on_dark_muted">#9E9E9E</color>

    <!-- Semantic -->
    <color name="semantic_success">#4CC766</color>
    <color name="semantic_warning">#FFB871</color>
    <color name="semantic_error">#FF6B6B</color>
</resources>
